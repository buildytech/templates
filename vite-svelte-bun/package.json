{
  "name": "@buildy-ui/vite-svelte-bun-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "check:ui8kit": "ui8kit check",
    "gen:contracts": "bun scripts/gen-block-contracts.ts",
    "contract:validate": "bun scripts/validate-content.ts",
    "lint:px": "bun scripts/ui8px-gate.ts",
    "test": "bun test tests",
    "verify": "bun run check:ui8kit && bun run contract:validate && bun run rules:check && bun run lint:px && bun run check && bun run test && bun run build",
    "rules:check": "bun scripts/rules-check.ts"
  },
  "ui8kit": {
    "runtime": "svelte",
    "kit": [
      "src/kit",
      "src/compose",
      "src/icons",
      "src/utils",
      "src/presets",
      "src/components"
    ],
    "composition": [
      "src/blocks",
      "src/sections",
      "src/App.svelte"
    ],
    "blockRoot": [
      "src/blocks",
      "src/sections"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide": "^1.78.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.19.2",
    "@ui8kit/contract": "0.5.0",
    "ajv": "^8.20.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "ui8kit": "3.5.0",
    "ui8px": "0.3.0",
    "vite": "^8.3.6"
  }
}
