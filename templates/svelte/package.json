{
  "name": "buildy-starter-svelte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:ui8kit": "ui8kit check",
    "rules:check": "bun scripts/rules-check.ts",
    "lint:px": "bun scripts/ui8px-gate.ts",
    "verify": "bun run check:ui8kit && bun run rules:check && bun run lint:px && bun run check && bun run build"
  },
  "ui8kit": {
    "runtime": "svelte",
    "kit": [
      "src/kit",
      "src/compose",
      "src/icons",
      "src/utils",
      "src/presets",
      "src/components"
    ],
    "composition": [
      "src/blocks",
      "src/sections",
      "src/layouts",
      "src/App.svelte"
    ],
    "blockRoot": [
      "src/sections",
      "src/layouts",
      "src/App.svelte"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide": "^1.81.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/bun": "^1.4.5",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "ui8kit": "3.5.0",
    "ui8px": "0.3.0",
    "vite": "^8.4.0"
  }
}
