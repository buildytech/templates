{
  "name": "@buildy-ui/vite-react-bun-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "oxlint src tests --deny-warnings && tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check:ui8kit": "bun scripts/check-ui8kit.mjs",
    "ci": "bun run check:ui8kit && bun run lint && bun run test && bun run build",
    "verify": "bun run ci"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.8.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
